# Copy to .env.local and fill in. Never commit real values.

# Public address of the store (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://autoflex.ua

# ── Database (MongoDB Atlas) ───────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers. Required in production.
# In development you may leave it empty: a local MongoDB is started automatically
# (mongodb-memory-server) and keeps its data in ./data/mongo.
MONGODB_URI=
MONGODB_DB=autoflex
# Local database only: data directory (default ./data/mongo) and permission to use it
# outside development (e.g. "next build" / "next start" on your machine without Atlas).
# LOCAL_MONGO_PATH=./data/mongo
# ALLOW_LOCAL_DB=true

# ── Back office (/admin) ───────────────────────────────────────────────────
# Optional: create the owner account on first start instead of the setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo data (orders, suppliers, customers…) is seeded into an empty database in
# development. Set to "true" to seed elsewhere, "false" to disable.
ADMIN_SEED_DEMO=

# ── Supplier feed (DD Tuning / DD Audio) ─────────────────────────────────
# Partner API token from https://ddtuning.com.ua/developers.html. With it the catalog
# (103 000+ products, categories, prices, stock) is imported and kept in sync from the
# admin («Постачальник DD») or by the cron route below. Without it a small demo catalog is used.
DDTUNING_API_TOKEN=
# Secret for GET /api/cron/ddtuning-sync (Authorization: Bearer <secret>); schedule it hourly.
CRON_SECRET=

# Storage quota of the Atlas cluster in MB (M0 free = 512, Flex = 5120, M10 = 10240). The catalog sync
# refuses to start when less than SYNC_MIN_FREE_MB (default 150) would stay free, because Atlas blocks
# every write once the quota is reached.
MONGODB_STORAGE_LIMIT_MB=512

# ── Notifications ──────────────────────────────────────────────────────────
# Orders and requests are stored in the database and additionally delivered to the
# managers through these channels (optional, but recommended).

# Telegram: create a bot with @BotFather, add it to the managers' chat,
# then put the bot token and the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: JSON POST of every order / request to a CRM or automation webhook
ORDER_WEBHOOK_URL=

# Copy to .env.local and fill in. Never commit real values.

# Public address of the store (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://autoflex.ua

# Where orders and callback requests are delivered. Configure at least one channel
# before going live: without a channel, checkout fails in production
# (in development the message is printed to the terminal instead).

# Telegram: create a bot with @BotFather, add it to the managers' chat,
# then put the bot token and the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: JSON POST of every order / request to a CRM or automation webhook
ORDER_WEBHOOK_URL=
